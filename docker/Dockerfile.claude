# Real Claude Code + corkern v2 on fresh "devices" (no v1 here — see Dockerfile.e2e for that).
# The Claude token is NEVER part of the image: it is passed at `docker run` time only
# (make test-claude), and .env is excluded from the build context by .dockerignore.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y -qq git python3 curl ca-certificates jq >/dev/null && \
    rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /usr/local/bin/
# IWE (knowledge graph + MCP server) for corkern iwe — pinned release, checksum verified
# (no advisories for iwe-org/iwe as of 2026-10-02; same version as the dev machine)
ARG IWE_VERSION=0.24.2
ARG IWE_SHA256=8da08809b3801c56f065f6274c40ba5ba8e692e1c83b06230f4f5f9a39243e31
RUN curl -fsSL -o /tmp/iwe.tgz "https://github.com/iwe-org/iwe/releases/download/iwe-v${IWE_VERSION}/iwe-v${IWE_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    && echo "${IWE_SHA256}  /tmp/iwe.tgz" | sha256sum -c - \
    && tar -xzf /tmp/iwe.tgz -C /usr/local/bin iwe iwec iwes && rm /tmp/iwe.tgz
ARG CLAUDE_VERSION=2.1.285
RUN for u in alice bob; do \
        useradd -m -s /bin/bash "$u" && \
        runuser -u "$u" -- bash -c "curl -fsSL https://claude.ai/install.sh | bash -s $CLAUDE_VERSION" >/dev/null; \
    done
COPY . /src
CMD ["bash", "/src/docker/claude/run.sh"]
