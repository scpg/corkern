FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y -qq git python3 python3-pip curl ca-certificates shellcheck 2>/dev/null && \
    rm -rf /var/lib/apt/lists/*
# Pinned uv from the official image (reproducible; no curl | sh)
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /usr/local/bin/
RUN git config --global user.email "ci@corkern.local" && \
    git config --global user.name "corkern-ci"
WORKDIR /corkern
COPY . /corkern
RUN uv venv --seed && uv pip install -e ".[dev]"
