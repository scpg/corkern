# corkern as users get it: installed from PyPI or TestPyPI, never from this checkout.
# The image holds only the test scripts (no corkern source); no host folder is mounted, so the
# test cannot reach the developer's HOME, ~/.claude or any real knowledge repository.
# Same packages as Dockerfile.teams (+ curl to compare the files with the index's digests).
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y -qq git python3 curl ca-certificates openssh-client jq >/dev/null && \
    rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /usr/local/bin/
RUN useradd -m -s /bin/bash alice && useradd -m -s /bin/bash bob && useradd -m -s /bin/bash eve
COPY docker/e2e/lib.sh docker/published/ /test/
CMD ["bash", "/test/run.sh"]
