FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && \
    apt-get install -y -qq git python3 curl ca-certificates shellcheck >/dev/null && \
    rm -rf /var/lib/apt/lists/*
# Pinned uv, system-wide so the non-root test users can run install.sh
COPY --from=ghcr.io/astral-sh/uv:0.11.23 /uv /uvx /usr/local/bin/
# Real graphify (pinned, same as the dev machine) for corkern graphify end-to-end
RUN UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin uv tool install -q graphifyy==0.8.44 \
    && chmod -R a+rX /opt/uv-tools
# Real code-review-graph for corkern crg (CVE-checked 2026-10-02: none for 2.3.9; its mcp
# dependency had CVEs fixed up to 1.28.1 — the build fails if an older mcp gets resolved)
RUN UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin uv tool install -q code-review-graph==2.3.9 \
    && chmod -R a+rX /opt/uv-tools \
    && mcp=$(uv pip list -q --python /opt/uv-tools/code-review-graph/bin/python | awk '$1=="mcp"{print $2}') \
    && echo "code-review-graph uses mcp $mcp" \
    && [ "$(printf '%s\n1.28.1\n' "$mcp" | sort -V | head -1)" = "1.28.1" ]
RUN useradd -m -s /bin/bash alice && useradd -m -s /bin/bash bob
COPY . /src
CMD ["bash", "/src/docker/e2e/run.sh"]
